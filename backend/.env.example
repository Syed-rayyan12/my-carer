# Public local-development credentials only. Use deployment secrets in production.
PORT=4000
NODE_ENV=development
DATABASE_URL=postgresql://carer:local_development_only@localhost:5432/carer?schema=public
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
# Number of trusted reverse-proxy hops; 0 disables proxy trust.
TRUST_PROXY=0
