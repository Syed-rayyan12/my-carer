# Public local-development credentials only. Use deployment secrets in production.
PORT=4000
NODE_ENV=development
DATABASE_URL=postgresql://carer:local_development_only@localhost:5432/carer?schema=public
# Per API process; size against PostgreSQL capacity and the number of instances.
DATABASE_POOL_MAX=5
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
# Local development only. Production always enforces request limits and login lockouts.
DISABLE_RATE_LIMITS=false
# Number of trusted reverse-proxy hops; 0 disables proxy trust.
TRUST_PROXY=0
SESSION_HOURS=12
SESSION_REMEMBER_DAYS=30
SESSION_IDLE_MINUTES=60
# Set both temporarily to provision the first admin with npm run admin:create.
# ADMIN_SEED_EMAIL=admin@example.com
# ADMIN_SEED_PASSWORD=choose-a-unique-password-at-least-12-characters

# Subscription billing: enable only after deploying the database migration.
STRIPE_ENABLED=false
STRIPE_MODE=test
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# BILLING_RETURN_ORIGIN=https://your-application-frontend.example
