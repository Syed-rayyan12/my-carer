# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.npm-cache/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# Local browser profile/crash data; never publish
/.browser-style-check/

# Original client document (runtime pricing data is versioned separately)
/public/My-Carer-Pricing.docx

# One-off local account maintenance
/backend/scripts/reset-local-admin.ts
/backend/scripts/clear-non-admin-users.ts

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
